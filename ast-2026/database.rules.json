{
  "rules": {
    ".read": false,
    ".write": false,
    "crews": {
      "$crew": {
        ".read": "auth != null && $crew.length >= 10",
        "plan": {
          ".write": "auth != null && $crew.length >= 10",
          ".validate": "newData.child('stops').exists() || !newData.exists() || newData.hasChildren(['ts'])"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 40)"
          }
        },
        "status": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "pos": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('ts').isNumber())"
          }
        },
        "meetups": {
          "$mid": {
            "meta": {
              ".write": "auth != null && $crew.length >= 10 && (newData.exists() || data.child('by').val() === auth.uid)"
            },
            "props": {
              "$pid": {
                ".write": "auth != null && $crew.length >= 10 && (!data.exists() || data.child('by').val() === auth.uid)",
                ".validate": "!newData.exists() || (newData.child('by').val() === auth.uid && newData.child('when').isNumber() && newData.child('lat').isNumber() && newData.child('lng').isNumber())"
              }
            },
            "rsvp": {
              "$pid": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid",
                  ".validate": "!newData.exists() || newData.val() === 1 || newData.val() === -1"
                }
              }
            }
          }
        },
        "pub": {
          ".write": "auth != null && $crew.length >= 10 && !data.exists() && root.child('crews/'+$crew+'/members/'+auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 20"
        }
      }
    },
    "study": {
      "$uid": {
        "$batch": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['ts','ev']) && newData.child('ts').isNumber()"
        }
      }
    },
    "pubmembers": {
      "$pub": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('crews/'+newData.val()+'/members/'+auth.uid).exists() && root.child('crews/'+newData.val()+'/pub').val() === $pub))",
          ".validate": "!newData.exists() || newData.isString()"
        }
      }
    },
    "directory": {
      ".read": "auth != null",
      "$pub": {
        ".write": "auth != null && root.child('pubmembers/'+$pub+'/'+auth.uid).exists()",
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('n').isNumber() && newData.child('ts').isNumber())"
      }
    },
    "joinreq": {
      "$pub": {
        ".read": "auth != null && root.child('pubmembers/'+$pub+'/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || root.child('pubmembers/'+$pub+'/'+auth.uid).exists())",
          ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('status').isString())"
        }
      }
    }
  }
}